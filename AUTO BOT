    def update_canvas(self, *args):
        self.rect.pos = self.pos
        self.rect.size = self.size


def create_input(hint, is_password=False):
    tf = MDTextField(
        password=is_password,
        mode="outlined",
        size_hint_y=None,
        height=54
    )
    tf.add_widget(MDTextFieldHintText(text=hint))
    return tf


