# Enterprise-Grade 8K Dynamic Quantum Matrix Background Engine
class QuantumBackgroundEngine(MDBoxLayout):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.tick = 0
        with self.canvas.before:
            # Deep Quantum Void Base Color
            self.bg_color = Color(0.008, 0.015, 0.03, 1)
            self.bg_rect = Rectangle(size=self.size, pos=self.pos)

            # Primary Plasma Core (Cyan Glow)
            self.core1_color = Color(0.0, 0.8, 1.0, 0.15)
            self.core1 = RoundedRectangle(size=(600, 600), pos=(200, 150), radius=[300])

            # Secondary Plasma Core (Neon Emerald Glow)
            self.core2_color = Color(0.0, 1.0, 0.4, 0.12)
            self.core2 = RoundedRectangle(size=(700, 700), pos=(800, 200), radius=[350])

        self.bind(pos=self.update_graphics, size=self.update_graphics)
        Clock.schedule_interval(self.render_quantum_pulse, 1 / 60)

    def update_graphics(self, *args):
        self.bg_rect.pos = self.pos
        self.bg_rect.size = self.size

    def render_quantum_pulse(self, dt):
        self.tick += 0.5
        # Organic particle drift simulation
        px = math.cos(math.radians(self.tick)) * 140
        py = math.sin(math.radians(self.tick * 0.7)) * 90
        self.core1.pos = (250 + px, 120 + py)
        self.core2.pos = (750 - px, 220 - py)


# Professional Navigation Tab Pill
class CommandTabButton(Button):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.background_normal = ''
        self.background_color = (0, 0, 0, 0)
        self.color = (0.75, 0.85, 0.95, 1)
        self.bold = True
        self.font_size = 13
        with self.canvas.before:
            self.box_color = Color(0.05, 0.12, 0.22, 0.85)
            self.rect = RoundedRectangle(size=self.size, pos=self.pos, radius=[8])
        self.bind(pos=self.update_canvas, size=self.update_canvas)

    def update_canvas(self, *args):
        self.rect.pos = self.pos
        self.rect.size = self.size


# High-Precision Quantum Action Button
class QuantumActionBtn(Button):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.background_normal = ''
        self.background_color = (0, 0, 0, 0)
        self.color = (0.01, 0.03, 0.02, 1)
        self.bold = True
        self.font_size = 14
        with self.canvas.before:
            Color(0.0, 1.0, 0.4, 1)
            self.rect = RoundedRectangle(size=self.size, pos=self.pos, radius=[10])
