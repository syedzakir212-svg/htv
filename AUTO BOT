# MASTER APEX QUANTUM TERMINAL APP
class ApexQuantumApp(MDApp):
    def build(self):
        self.theme_style = "Dark"

        # Root Container with Quantum Animated Background
        root_layout = QuantumBackgroundEngine(orientation='vertical')

        # TOP PROFESSIONAL HEADER COMMAND DOCK
        top_bar = MDBoxLayout(orientation='horizontal', size_hint_y=None, height=70, padding=12, spacing=10,
                              md_bg_color=(0.015, 0.04, 0.08, 0.95))

        # Terminal Branding Title
        brand_label = MDLabel(
            text="⚡ APEX QUANTUM // HFT TERMINAL",
            bold=True,
            font_style="Title",
            role="medium",
            theme_text_color="Custom",
            text_color=(0.0, 1.0, 0.4, 1),
            size_hint_x=None,
            width=320
        )
        top_bar.add_widget(brand_label)

        # Top Navigation Control Pills
        tab_container = MDBoxLayout(orientation='horizontal', spacing=8)

        t1 = CommandTabButton(text="Betfair API")
        t2 = CommandTabButton(text="Matchbook")
        t3 = CommandTabButton(text="Risk Engine")
        t4 = CommandTabButton(text="Markets")
        t5 = CommandTabButton(text="Telemetry")
        t6 = CommandTabButton(text="8K Feed")

        tab_container.add_widget(t1)
        tab_container.add_widget(t2)
        tab_container.add_widget(t3)
        tab_container.add_widget(t4)
        tab_container.add_widget(t5)
        tab_container.add_widget(t6)

        top_bar.add_widget(tab_container)

        # Screen Manager with Cinematic Fade Transition
        self.sm = QuantumScreenManager(transition=FadeTransition(duration=0.25))
        self.sm.add_widget(BetfairTerminalScreen(name="screen1"))
        self.sm.add_widget(MatchbookTerminalScreen(name="screen2"))
        self.sm.add_widget(RiskEngineScreen(name="screen3"))
        self.sm.add_widget(GlobalMarketsScreen(name="screen4"))
        self.sm.add_widget(LiveTelemetryScreen(name="screen5"))
        self.sm.add_widget(SurveillanceScreen(name="screen6"))

        t1.bind(on_press=lambda x: setattr(self.sm, 'current', 'screen1'))
        t2.bind(on_press=lambda x: setattr(self.sm, 'current', 'screen2'))
        t3.bind(on_press=lambda x: setattr(self.sm, 'current', 'screen3'))
        t4.bind(on_press=lambda x: setattr(self.sm, 'current', 'screen4'))
        t5.bind(on_press=lambda x: setattr(self.sm, 'current', 'screen5'))
        t6.bind(on_press=lambda x: setattr(self.sm, 'current', 'screen6'))

        root_layout.add_widget(top_bar)
        root_layout.add_widget(self.sm)
        return root_layout


if __name__ == '__main__':
    ApexQuantumApp().run()
